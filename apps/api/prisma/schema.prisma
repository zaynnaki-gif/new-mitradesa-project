/// Transparansi Desa - APBDes
model Apbdes {
  id              BigInt   @id @default(autoincrement())
  desaId          BigInt   @map("desa_id")
  tahun           Int
  totalPendapatan Float    @default(0) @map("total_pendapatan")
  totalBelanja    Float    @default(0) @map("total_belanja")
  totalPembiayaan Float    @default(0) @map("total_pembiayaan")
  isAktif         Boolean  @default(true) @map("is_aktif")
  dokumenUrl      String?  @map("dokumen_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  desa  Desa         @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  items ApbdesItem[]

  @@unique([desaId, tahun])
  @@map("apbdes")
}

model ApbdesItem {
  id           BigInt         @id @default(autoincrement())
  apbdesId     BigInt         @map("apbdes_id")
  kategori     ApbdesKategori
  kodeRekening String?        @map("kode_rekening") @db.VarChar(50)
  nama         String         @db.VarChar(255)
  anggaran     Float          @default(0)
  realization  Float          @default(0) @map("realisasi")
  createdAt    DateTime       @default(now()) @map("created_at")

  apbdes     Apbdes    @relation(fields: [apbdesId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kasEntries KasUmum[]

  @@index([apbdesId])
  @@index([kodeRekening])
  @@map("apbdes_item")
}

enum ApbdesKategori {
  PENDAPATAN
  BELANJA
  PEMBIAYAAN
}

/// Agenda Desa
model Agenda {
  id             BigInt       @id @default(autoincrement())
  desaId         BigInt       @map("desa_id")
  judul          String       @db.VarChar(255)
  slug           String       @unique @db.VarChar(255)
  deskripsi      String       @db.Text
  lokasi         String       @db.VarChar(255)
  penyelenggara  String       @db.VarChar(255)
  tanggalMulai   DateTime     @map("tanggal_mulai") @db.Timestamp(6)
  tanggalSelesai DateTime     @map("tanggal_selesai") @db.Timestamp(6)
  status         AgendaStatus @default(MENDATANG)
  isAktif        Boolean      @default(true) @map("is_aktif")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  desa Desa @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([tanggalMulai])
  @@index([status])
  @@map("agenda")
}

enum AgendaStatus {
  MENDATANG
  BERLANGSUNG
  SELESAI
  BATAL
}

/// Arsip Surat Masuk
model SuratMasuk {
  id              BigInt           @id @default(autoincrement())
  desaId          BigInt           @map("desa_id")
  nomorSurat      String           @map("nomor_surat") @db.VarChar(100)
  tanggalSurat    DateTime         @map("tanggal_surat") @db.Date
  tanggalDiterima DateTime         @map("tanggal_diterima") @db.Date
  pengirim        String           @db.VarChar(255)
  perihal         String           @db.VarChar(500)
  lampiran        String?          @db.VarChar(255)
  fileScanUrl     String?          @map("file_scan_url") @db.VarChar(500)
  status          SuratMasukStatus @default(DITERIMA)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  desa      Desa        @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  disposisi Disposisi[]

  @@index([desaId])
  @@index([nomorSurat])
  @@map("surat_masuk")
}

model Disposisi {
  id             BigInt          @id @default(autoincrement())
  suratMasukId   BigInt          @map("surat_masuk_id")
  tujuan         String          @db.VarChar(255)
  instruksi      String          @db.Text
  tanggalSelesai DateTime?       @map("tanggal_selesai") @db.Date
  status         DisposisiStatus @default(PENDING)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  suratMasuk SuratMasuk @relation(fields: [suratMasukId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([suratMasukId])
  @@map("disposisi")
}

enum SuratMasukStatus {
  DITERIMA
  DIPROSES
  SELESAI
  DIARSIPKAN
}

enum DisposisiStatus {
  PENDING
  DIPROSES
  SELESAI
}

/// Potensi Desa
model PotensiDesa {

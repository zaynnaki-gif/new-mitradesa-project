// ============================================================
// Service Document Engine Models
// ============================================================

/// Service Definition - Administrative services offered by village
model Layanan {
  id               BigInt    @id @default(autoincrement())
  desaId           BigInt    @map("desa_id")
  kode             String    @db.VarChar(20)
  nama             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  deskripsi        String?   @db.Text
  kategori         String?   @map("kategori") @db.VarChar(100)
  requiresDocument Boolean   @default(false) @map("requires_document")
  requiresApproval Boolean   @default(true) @map("requires_approval")
  isActive         Boolean   @default(true) @map("is_active")
  isMandiri        Boolean   @default(false) @map("is_mandiri")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)

  fields      FieldDefinition[]
  dokumen     DokumenDefinition[]
  permintaan  PermintaanLayanan[]
  nomorConfig NomorSuratConfig[]
  desa        Desa                @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@unique([desaId, kode])
  @@index([desaId])
  @@index([slug])
  @@index([kategori])
  @@index([isActive])
  @@map("layanan")
}

/// Field Definition - Reusable field registry for services and templates
model FieldDefinition {
  id           BigInt    @id @default(autoincrement())
  layananId    BigInt?   @map("layanan_id")
  templateId   BigInt?   @map("template_id")
  key          String    @db.VarChar(100)
  label        String    @db.VarChar(255)
  type         FieldType
  source       String?   @db.VarChar(100)
  required     Boolean   @default(false)
  validation   Json?     @map("validation")
  defaultValue String?   @map("default_value") @db.VarChar(500)
  description  String?   @db.Text
  options      Json?
  placeholder  String?   @db.VarChar(255)
  orderIndex   Int       @default(0) @map("order_index")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  layanan  Layanan?       @relation(fields: [layananId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  template TemplateSurat? @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([layananId, key])
  @@unique([templateId, key])
  @@index([layananId])
  @@index([templateId])
  @@map("field_definition")
}

/// Service Request - Instance of a service request
model PermintaanLayanan {
  id              BigInt        @id @default(autoincrement())
  layananId       BigInt        @map("layanan_id")
  pendudukId      BigInt?       @map("penduduk_id")
  desaId          BigInt        @map("desa_id")
  nomorPermintaan String        @unique @map("nomor_permintaan") @db.VarChar(50)
  status          RequestStatus @default(DRAFT)
  dataJson        Json?         @map("data_json")
  catatan         String?       @db.Text
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamp(6)
  processedAt     DateTime?     @map("processed_at") @db.Timestamp(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamp(6)
  createdBy       BigInt?       @map("created_by")
  processedBy     BigInt?       @map("processed_by")
  approvedBy      BigInt?       @map("approved_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamp(6)

  dokumen   InstanDokumen[]
  layanan   Layanan         @relation(fields: [layananId], references: [id], onUpdate: NoAction)
  penduduk  Penduduk?       @relation(fields: [pendudukId], references: [id], onUpdate: NoAction)
  creator   Account?        @relation("RequestCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  processor Account?        @relation("RequestProcessedBy", fields: [processedBy], references: [id], onUpdate: NoAction)
  approver  Account?        @relation("RequestApprovedBy", fields: [approvedBy], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([layananId])
  @@index([pendudukId])
  @@index([status])
  @@index([nomorPermintaan])
  @@index([createdBy])
  @@map("permintaan_layanan")
}

/// Document Definition - Document types generated from services
model DokumenDefinition {
  id        BigInt   @id @default(autoincrement())
  layananId BigInt   @map("layanan_id")
  kode      String   @db.VarChar(20)
  nama      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates TemplateSurat[]
  instan    InstanDokumen[]
  layanan   Layanan         @relation(fields: [layananId], references: [id], onUpdate: NoAction)

  @@unique([layananId, kode])
  @@index([layananId])
  @@map("dokumen_definition")
}

/// Blanko - Letterhead template definitions
model Blanko {
  id        BigInt   @id @default(autoincrement())
  desaId    BigInt   @map("desa_id")
  nama      String   @db.VarChar(255)
  paperSize String   @default("F4") @map("paper_size") @db.VarChar(50)
  margin    Json
  layout    Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  desa      Desa            @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  templates TemplateSurat[]

  @@index([desaId])
  @@map("blanko")
}

/// Master list of codes for placeholders
model KodeIsianMaster {
  id         BigInt   @id @default(autoincrement())
  kode       String   @unique @db.VarChar(100)
  kategori   String   @db.VarChar(100)
  sumberData String   @map("sumber_data") @db.VarChar(255)
  keterangan String?  @db.Text
  isAktif    Boolean  @default(true) @map("is_aktif")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("kode_isian_master")
}

/// Template - Template master record
model TemplateSurat {
  id        BigInt   @id @default(autoincrement())
  dokumenId BigInt   @map("dokumen_id")
  blankoId  BigInt?  @map("blanko_id")
  nama      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  deskripsi String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions TemplateVersion[]
  fields   FieldDefinition[]
  dokumen  DokumenDefinition @relation(fields: [dokumenId], references: [id], onUpdate: NoAction)
  blanko   Blanko?           @relation(fields: [blankoId], references: [id], onUpdate: NoAction)

  @@index([dokumenId])
  @@map("template_surat")
}

/// Template Version - Versioned template content
model TemplateVersion {
  id              BigInt        @id @default(autoincrement())
  templateId      BigInt        @map("template_id")
  version         Int           @map("version")
  content         Json // Template layout and elements
  kopConfig       Json?         @map("kop_config")
  signatureConfig Json?         @map("signature_config")
  status          VersionStatus @default(DRAFT)
  changelog       String?       @db.Text
  createdBy       BigInt?       @map("created_by")
  publishedAt     DateTime?     @map("published_at") @db.Timestamp(6)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  instan   InstanDokumen[]
  template TemplateSurat   @relation(fields: [templateId], references: [id], onUpdate: NoAction)
  creator  Account?        @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@unique([templateId, version])
  @@index([templateId])
  @@index([status])
  @@map("template_version")
}

/// Document Instance - Immutable snapshot of generated document
model InstanDokumen {
  id                BigInt         @id @default(autoincrement())
  dokumenId         BigInt         @map("dokumen_id")
  permintaanId      BigInt?        @map("permintaan_id")
  templateVersionId BigInt         @map("template_version_id")
  nomorDokumen      String         @unique @map("nomor_dokumen") @db.VarChar(50)
  judul             String         @db.VarChar(255)
  dataSnapshot      Json           @map("data_snapshot")
  contentSnapshot   Json           @map("content_snapshot")
  status            DocumentStatus @default(GENERATED)
  generatedAt       DateTime       @default(now()) @map("generated_at")
  signedAt          DateTime?      @map("signed_at") @db.Timestamp(6)
  qrCode            String?        @map("qr_code") @db.VarChar(500)
  verificationToken String?        @unique @map("verification_token") @db.VarChar(100)
  fileUrl           String?        @map("file_url") @db.VarChar(500)
  tujuan            String?        @db.VarChar(255)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  signature       DokumenSignature?
  verifikasi      VerifikasiDokumen?
  dokumen         DokumenDefinition  @relation(fields: [dokumenId], references: [id], onUpdate: NoAction)
  permintaan      PermintaanLayanan? @relation(fields: [permintaanId], references: [id], onUpdate: NoAction)
  templateVersion TemplateVersion    @relation(fields: [templateVersionId], references: [id], onUpdate: NoAction)

  @@index([dokumenId])
  @@index([permintaanId])
  @@index([templateVersionId])
  @@index([nomorDokumen])
  @@index([verificationToken])
  @@map("instan_dokumen")
}

/// Document Number Sequence - Per-village sequence counter
model NomorDokumen {
  id           BigInt   @id @default(autoincrement())
  desaId       BigInt   @unique @map("desa_id")
  lastSequence BigInt   @default(0) @map("last_sequence")
  lastYear     Int      @default(0) @map("last_year")
  updatedAt    DateTime @updatedAt @map("updated_at")

  desa Desa @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@map("nomor_dokumen")
}

/// Numbering Configuration - Per-service numbering format
model NomorSuratConfig {
  id             BigInt   @id @default(autoincrement())
  layananId      BigInt   @unique @map("layanan_id")
  formatTemplate String   @map("format_template") @db.VarChar(255)
  startingNumber BigInt   @default(1) @map("starting_number")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  layanan Layanan @relation(fields: [layananId], references: [id], onUpdate: NoAction)

  @@index([layananId])
  @@map("nomor_surat_config")
}

/// Signatory - Authorized signatories for documents
model PenandaTangan {
  id             BigInt   @id @default(autoincrement())
  desaId         BigInt   @map("desa_id")
  accountId      BigInt?  @map("account_id")
  pinHash        String?  @map("pin_hash") @db.VarChar(255)
  nama           String   @db.VarChar(255)
  jabatan        String   @db.VarChar(255)
  nip            String?  @db.VarChar(50)
  tandaTanganUrl String?  @map("tanda_tangan_url") @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  signatures DokumenSignature[]
  desa       Desa               @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  account    Account?           @relation(fields: [accountId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([accountId])
  @@map("penanda_tangan")
}

/// Document Signature - Signature record for documents
model DokumenSignature {
  id              BigInt        @id @default(autoincrement())
  dokumenId       BigInt        @unique @map("dokumen_id")
  penandatanganId BigInt        @map("penandatangan_id")
  tandaTanganUrl  String?       @map("tanda_tangan_url") @db.VarChar(500)
  tandaTanganType SignatureType @default(IMAGE)
  signedAt        DateTime      @default(now()) @map("signed_at")
  ipAddress       String?       @map("ip_address") @db.VarChar(45)
  createdAt       DateTime      @default(now()) @map("created_at")

  dokumen       InstanDokumen @relation(fields: [dokumenId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  penandatangan PenandaTangan @relation(fields: [penandatanganId], references: [id], onUpdate: NoAction)

  @@index([dokumenId])
  @@index([penandatanganId])
  @@map("dokumen_signature")
}

/// Document Verification - Public verification records
model VerifikasiDokumen {
  id           BigInt             @id @default(autoincrement())
  dokumenId    BigInt             @unique @map("dokumen_id")
  token        String             @unique @db.VarChar(100)
  qrCodeUrl    String?            @map("qr_code_url") @db.VarChar(500)
  status       VerificationStatus @default(PENDING)
  verifiedAt   DateTime?          @map("verified_at") @db.Timestamp(6)
  verifyCount  Int                @default(0) @map("verify_count")
  lastVerifyAt DateTime?          @map("last_verify_at") @db.Timestamp(6)
  createdAt    DateTime           @default(now()) @map("created_at")

  dokumen InstanDokumen @relation(fields: [dokumenId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([dokumenId])
  @@map("verifikasi_dokumen")
}


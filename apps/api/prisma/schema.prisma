generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provinsi {
  id         BigInt      @id @default(autoincrement())
  kode       String      @unique @db.VarChar(10)
  nama       String      @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  kabupatens Kabupaten[]

  @@index([nama])
  @@map("provinsi")
}

model Kabupaten {
  id         BigInt      @id @default(autoincrement())
  provinsiId BigInt      @map("provinsi_id")
  kode       String      @db.VarChar(10)
  nama       String      @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  provinsi   Provinsi    @relation(fields: [provinsiId], references: [id], onUpdate: NoAction, map: "kabupaten_provinsi_id_foreign")
  kecamatans Kecamatan[]

  @@unique([provinsiId, kode])
  @@index([provinsiId])
  @@index([kode])
  @@index([nama])
  @@map("kabupaten")
}

model Kecamatan {
  id          BigInt    @id @default(autoincrement())
  kabupatenId BigInt    @map("kabupaten_id")
  kode        String    @db.VarChar(10)
  nama        String    @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  desas       Desa[]
  kabupaten   Kabupaten @relation(fields: [kabupatenId], references: [id], onUpdate: NoAction, map: "kecamatan_kabupaten_id_foreign")

  @@unique([kabupatenId, kode])
  @@index([kabupatenId])
  @@index([kode])
  @@index([nama])
  @@map("kecamatan")
}

model Desa {
  id             BigInt          @id @default(autoincrement())
  kecamatanId    BigInt          @map("kecamatan_id")
  kode           String          @db.VarChar(10)
  nama           String          @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  kecamatan      Kecamatan       @relation(fields: [kecamatanId], references: [id], onUpdate: NoAction, map: "desa_kecamatan_id_foreign")
  identitasDesa  IdentitasDesa?
  keluargas      Keluarga[]
  penduduks      Penduduk[]
  perangkatDesas PerangkatDesa[]
  kategoris      Kategori[]
  halamans       Halaman[]
  layanans       Layanan[]
  penandaTangans PenandaTangan[]
  nomorDokumen   NomorDokumen[]
  umkms          Umkm[]
  apbdes         Apbdes[]
  agenda         Agenda[]
  SuratMasuk     SuratMasuk[]
  PotensiDesa    PotensiDesa[]
  gubugs         Gubug[]
  banners        Banner[]

  @@unique([kecamatanId, kode])
  @@index([kecamatanId])
  @@index([kode])
  @@index([nama])
  @@map("desa")
}

model Gubug {
  id        BigInt    @id @default(autoincrement())
  desaId    BigInt    @map("desa_id")
  kode      String    @db.VarChar(20)
  nama      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  rws       Rw[]
  desa      Desa      @relation(fields: [desaId], references: [id], onUpdate: NoAction, map: "gubug_desa_id_foreign")

  @@unique([desaId, kode])
  @@index([desaId])
  @@map("gubug")
}

model Rw {
  id        BigInt    @id @default(autoincrement())
  gubugId   BigInt    @map("gubug_id")
  kode      String    @db.VarChar(20)
  nama      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  rts       Rt[]
  gubug     Gubug    @relation(fields: [gubugId], references: [id], onUpdate: NoAction, map: "rw_gubug_id_foreign")

  @@unique([gubugId, kode])
  @@index([gubugId])
  @@map("rw")
}

model Rt {
  id        BigInt    @id @default(autoincrement())
  rwId      BigInt    @map("rw_id")
  kode      String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  rw        Rw       @relation(fields: [rwId], references: [id], onUpdate: NoAction, map: "rt_rw_id_foreign")

  @@unique([rwId, kode])
  @@index([rwId])
  @@map("rt")
}

/// Lembaga - Organisasi kemasyarakatan: BPD, PKK, KADER, RT, RW, dll
model Lembaga {
  id          BigInt    @id @default(autoincrement())
  desaId     BigInt    @map("desa_id")
  jenis       String    @db.VarChar(50)  // BPD, PKK, KADER, RT, RW, dll
  nama        String    @db.VarChar(255)
  deskripsi   String?   @db.Text
  pimpinanId  BigInt?   @map("penduduk_id")  // Foreign key to Penduduk (nullable - leader optional)
  gubugId    BigInt?   @map("gubug_id")
  rwId       BigInt?    @map("rw_id")
  rtId       BigInt?    @map("rt_id")
  status      String    @default("AKTIF") @map("status") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([desaId])
  @@index([jenis])
  @@index([gubugId])
  @@index([rwId])
  @@index([rtId])
  @@map("lembaga")
}

model IdentitasDesa {
  id               BigInt   @id @default(autoincrement())
  desaId           BigInt   @unique @map("desa_id")
  namaDesa         String   @map("nama_desa") @db.VarChar(100)
  singkatanDesa    String?  @map("singkatan_desa") @db.VarChar(20)
  kodeDesa         String?  @map("kode_desa") @db.VarChar(10)
  alamat           String?
  kodepos          String?  @map("kodepos") @db.VarChar(10)
  telepon          String?  @map("telepon") @db.VarChar(20)
  whatsapp         String?  @db.VarChar(20)
  email            String?  @db.VarChar(255)
  website          String?  @db.VarChar(255)
  logoDesaUrl      String?  @map("logo_desa_url") @db.VarChar(500)
  logoKabupatenUrl String?  @map("logo_kabupaten_url") @db.VarChar(500)
  faviconUrl       String?  @map("favicon_url") @db.VarChar(500)
  kepalaDesa       String?  @map("kepala_desa") @db.VarChar(100)
  sekretarisDesa   String?  @map("sekretaris_desa") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  desa             Desa     @relation(fields: [desaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "identitas_desa_desa_id_foreign")

  @@index([desaId])
  @@map("identitas_desa")
}

model Account {
  id                BigInt              @id @default(autoincrement())
  username          String              @unique @db.VarChar(50)
  email             String              @unique @db.VarChar(255)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  status            AccountStatus?      @default(ACTIVE)
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamp(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  accountRoles      AccountRole[]
  internalSessions  InternalSession[]
  perangkatDesa     PerangkatDesa?
  beritas           Berita[]            @relation("BeritaPenulis")
  halamans          Halaman[]           @relation("HalamanCreatedBy")
  medias            Media[]             @relation("MediaUploadedBy")
  createdRequests   PermintaanLayanan[] @relation("RequestCreatedBy")
  processedRequests PermintaanLayanan[] @relation("RequestProcessedBy")
  approvedRequests  PermintaanLayanan[] @relation("RequestApprovedBy")
  templateVersions  TemplateVersion[]

  @@map("account")
}

model Role {
  id              BigInt           @id @default(autoincrement())
  name            String           @db.VarChar(100)
  code            String           @unique(map: "role_code_key") @map("role_code") @db.VarChar(50)
  description     String?
  isSystem        Boolean?         @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  accountRoles    AccountRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  name            String           @db.VarChar(100)
  code            String           @unique(map: "permission_code_key") @map("permission_code") @db.VarChar(100)
  description     String?
  groupName       String?          @map("group_name") @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  rolePermissions RolePermission[]

  @@map("permission")
}

model AccountRole {
  id        BigInt   @id @default(autoincrement())
  accountId BigInt   @map("account_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_role_account_id_foreign")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_role_role_id_foreign")

  @@unique([accountId, roleId])
  @@map("account_role")
}

model RolePermission {
  id           BigInt     @id @default(autoincrement())
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permission_permission_id_foreign")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permission_role_id_foreign")

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model CitizenVerification {
  id            BigInt              @id @default(autoincrement())
  pendudukId    BigInt              @map("penduduk_id")
  challenge     String              @unique @map("verification_challenge") @db.VarChar(100)
  status        VerificationStatus? @default(PENDING)
  attempts      Int?                @default(0)
  expiresAt     DateTime            @map("expires_at") @db.Timestamp(6)
  verifiedAt    DateTime?           @map("verified_at") @db.Timestamp(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  penduduk      Penduduk            @relation(fields: [pendudukId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "citizen_verification_penduduk_id_foreign")
  otpChallenges OtpChallenge[]

  @@map("citizen_verification")
}

model OtpChallenge {
  id             BigInt              @id @default(autoincrement())
  verificationId BigInt              @map("verification_id")
  otpHash        String              @map("otp_hash") @db.VarChar(255)
  challenge      String              @unique @map("otp_challenge") @db.VarChar(100)
  status         OtpStatus?          @default(ACTIVE)
  attempts       Int?                @default(0)
  expiresAt      DateTime            @map("expires_at") @db.Timestamp(6)
  usedAt         DateTime?           @map("used_at") @db.Timestamp(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  verification   CitizenVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "otp_challenge_verification_id_foreign")

  @@map("otp_challenge")
}

model CitizenSession {
  id         BigInt    @id @default(autoincrement())
  pendudukId BigInt    @map("penduduk_id")
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  penduduk   Penduduk  @relation(fields: [pendudukId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "citizen_session_penduduk_id_foreign")

  @@map("citizen_session")
}

model InternalSession {
  id        BigInt    @id @default(autoincrement())
  accountId BigInt    @map("account_id")
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "internal_session_account_id_foreign")

  @@map("internal_session")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   BigInt      @map("entity_id")
  action     AuditAction
  actorId    BigInt?     @map("actor_id")
  actorType  ActorType?  @default(USER)
  actorIp    String?     @map("actor_ip") @db.VarChar(45)
  actorAgent String?     @map("actor_agent") @db.VarChar(500)
  beforeData Json?       @map("before_data")
  afterData  Json?       @map("after_data")
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

model Configuration {
  id          BigInt      @id @default(autoincrement())
  groupName   String      @map("group_name") @db.VarChar(100)
  key         String      @db.VarChar(100)
  value       String?
  value_type  ConfigType? @default(STRING)
  description String?
  isSystem    Boolean?    @default(false) @map("is_system")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([groupName, key])
  @@map("configuration")
}

model Penduduk {
  id                   BigInt                @id @default(autoincrement())
  nik                  String                @unique @db.VarChar(16)
  namaLengkap          String                @map("nama_lengkap") @db.VarChar(255)
  tempatLahir          String                @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir         DateTime              @map("tanggal_lahir") @db.Date
  jenisKelamin         String                @map("jenis_kelamin") @db.VarChar(1)
  golDarah             String?               @map("gol_darah") @db.VarChar(3)
  agama                String?               @map("agama") @db.VarChar(50)
  statusPerkawinan     String                @map("status_perkawinan") @db.VarChar(50)
  hubunganKeluarga     String?               @map("hubungan_keluarga") @db.VarChar(50)
  alamat               String?
  rt                   String?               @map("rt") @db.VarChar(10)
  rw                   String?               @map("rw") @db.VarChar(10)
  dusun                String?               @db.VarChar(100)
  kodePos              String?               @map("kode_pos") @db.VarChar(10)
  telepon              String?               @map("telepon") @db.VarChar(20)
  email                String?               @db.VarChar(255)
  wargaNegara          String?               @default("Indonesia") @map("warga_negara") @db.VarChar(50)
  nikAyah              String?               @map("nik_ayah") @db.VarChar(16)
  nikIbu               String?               @map("nik_ibu") @db.VarChar(16)
  isAktif              Boolean?              @default(true) @map("is_aktif")
  statusKepindahan     String?               @map("status_kepindahan") @db.VarChar(50)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamp(6)
  desaId               BigInt?               @map("desa_id")
  anggotaKeluarga      AnggotaKeluarga[]
  citizenSessions      CitizenSession[]
  citizenVerifications CitizenVerification[]
  keluargaAsKepala     Keluarga?             @relation("KeluargaKepala")
  desa                 Desa?                 @relation(fields: [desaId], references: [id], onUpdate: NoAction, map: "penduduk_desa_id_foreign")
  perangkatDesas       PerangkatDesa[]
  permintaan           PermintaanLayanan[]

  @@index([nik])
  @@index([desaId])
  @@index([namaLengkap])
  @@map("penduduk")
}

model Keluarga {
  id        BigInt            @id @default(autoincrement())
  noKk      String            @unique @map("no_kk") @db.VarChar(16)
  kepalaId  BigInt            @unique @map("kepala_id")
  alamat    String?
  rt        String?           @map("rt") @db.VarChar(10)
  rw        String?           @map("rw") @db.VarChar(10)
  dusun     String?           @db.VarChar(100)
  kodePos   String?           @map("kode_pos") @db.VarChar(10)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime?         @map("deleted_at") @db.Timestamp(6)
  desaId    BigInt?           @map("desa_id")
  anggota   AnggotaKeluarga[]
  desa      Desa?             @relation(fields: [desaId], references: [id], onUpdate: NoAction, map: "keluarga_desa_id_foreign")
  kepala    Penduduk          @relation("KeluargaKepala", fields: [kepalaId], references: [id], onUpdate: NoAction, map: "keluarga_kepala_id_foreign")

  @@index([noKk])
  @@index([kepalaId])
  @@index([desaId])
  @@map("keluarga")
}

model AnggotaKeluarga {
  id         BigInt   @id @default(autoincrement())
  keluargaId BigInt   @map("keluarga_id")
  pendudukId BigInt   @map("penduduk_id")
  hubungan   String   @map("hubungan") @db.VarChar(50)
  isAktif    Boolean? @default(true) @map("is_aktif")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  keluarga   Keluarga @relation(fields: [keluargaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "anggota_keluarga_keluarga_id_foreign")
  penduduk   Penduduk @relation(fields: [pendudukId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "anggota_keluarga_penduduk_id_foreign")

  @@unique([keluargaId, pendudukId])
  @@index([keluargaId])
  @@index([pendudukId])
  @@map("anggota_keluarga")
}

model PerangkatDesa {
  id         BigInt    @id @default(autoincrement())
  pendudukId BigInt    @map("penduduk_id")
  desaId     BigInt    @map("desa_id")
  jabatan    String    @map("jabatan") @db.VarChar(100)
  status     String    @default("AKTIF") @map("status") @db.VarChar(50)
  fotoUrl    String?   @map("foto_url") @db.VarChar(500)
  accountId  BigInt?   @unique @map("account_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  account    Account?  @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  desa       Desa      @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  penduduk   Penduduk  @relation(fields: [pendudukId], references: [id], onUpdate: NoAction)

  @@index([pendudukId])
  @@index([desaId])
  @@index([jabatan])
  @@index([status])
  @@map("perangkat_desa")
}

model RefAgama {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(10)
  nama      String   @map("nama") @db.VarChar(100)
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kode])
  @@index([nama])
  @@map("ref_agama")
}

model RefGolonganDarah {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(5)
  nama      String   @map("nama") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ref_gol_darah")
}

model RefStatusPerkawinan {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(10)
  nama      String   @map("nama") @db.VarChar(50)
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kode])
  @@map("ref_status_perkawinan")
}

model RefHubunganKeluarga {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(20)
  nama      String   @map("nama") @db.VarChar(50)
  kategori  String   @map("kategori") @db.VarChar(20)
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kode])
  @@index([kategori])
  @@map("ref_hubungan_keluarga")
}

model RefStatusKependudukan {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(20)
  nama      String   @map("nama") @db.VarChar(100)
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kode])
  @@map("ref_status_kependudukan")
}

model RefPendidikan {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @map("kode") @db.VarChar(10)
  nama      String   @map("nama") @db.VarChar(100)
  jenjang   Int      @map("jenjang")
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kode])
  @@index([jenjang])

  alt          String?   @db.VarChar(255)
  kategori     String?   @map("kategori") @db.VarChar(50)
  uploadedById BigInt?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)
  uploadedBy   Account?  @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onUpdate: NoAction, map: "media_uploaded_by_id_foreign")

  @@index([slug])
  @@index([fileType])
  @@index([kategori])
  @@index([uploadedById])
  @@map("media")
}

/// UMKM & Potensi Desa
model Umkm {

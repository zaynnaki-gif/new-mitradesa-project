// ============================================================
// Posyandu Kesehatan
// ============================================================

model PosyanduKunjungan {
  id               String   @id @default(cuid())
  desaId           BigInt?  @map("desa_id")
  pendudukId       BigInt   @map("penduduk_id")
  tanggalKunjungan DateTime @map("tanggal_kunjungan") @db.Date
  kategori         String   @db.VarChar(30) // IBU_HAMIL, BALITA, LANSIA, UMUM
  mingguKehamilan  Int?
  tekananDarah     String?  @map("tekanan_darah") @db.VarChar(20)
  beratBadanIbu    Float?
  beratBadan       Float?
  panjangBadan     Float?
  lingkarKepala    Float?
  statusGizi       String?
  gulaDarah        Float?
  imunisasi        String?
  vitamin          String?
  catatan          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  desa             Desa?    @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([pendudukId])
  @@index([tanggalKunjungan])
  @@index([kategori])
  @@map("posyandu_kunjungan")
}

model Bumil {
  id          String   @id @default(cuid())
  desaId      BigInt?  @map("desa_id")
  pendudukId  BigInt   @unique @map("penduduk_id")
  namaLengkap String   @map("nama_lengkap") @db.VarChar(255)
  nik         String   @map("nik") @db.VarChar(16)
  telepon     String?
  alamat      String?
  trimester   Int?     @default(1)
  // FK references to wilayah hierarchy
  gubugId     BigInt?  @map("gubug_id")
  rwId        BigInt?  @map("rw_id")
  rtId        BigInt?  @map("rt_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  desa  Desa?  @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  gubug Gubug? @relation("GubugToBumil", fields: [gubugId], references: [id], onUpdate: NoAction, map: "bumil_gubug_id_foreign")
  rwRel Rw?    @relation("RwToBumil", fields: [rwId], references: [id], onUpdate: NoAction, map: "bumil_rw_id_foreign")
  rtRel Rt?    @relation("RtToBumil", fields: [rtId], references: [id], onUpdate: NoAction, map: "bumil_rt_id_foreign")

  @@index([desaId])
  @@index([pendudukId])
  @@index([gubugId])
  @@index([rwId])
  @@index([rtId])
  @@map("bumil")
}

model KasUmum {
  id           String      @id @default(cuid())
  desaId       BigInt?     @map("desa_id")
  tanggal      DateTime    @db.Date
  jenis        String      @db.VarChar(20) // KAS_MASUK, KAS_KELUAR
  uraian       String      @db.VarChar(500)
  jumlah       Float
  saldo        Float
  kodeRekening String?     @map("kode_rekening") @db.VarChar(50)
  apbdesItemId BigInt?     @map("apbdes_item_id")
  createdAt    DateTime    @default(now())

  desa         Desa?       @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  apbdesItem   ApbdesItem? @relation(fields: [apbdesItemId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([apbdesItemId])
  @@index([kodeRekening])
  @@map("kas_umum")
}

model BukuBank {
  id           String   @id @default(cuid())
  desaId       BigInt?  @map("desa_id")
  bank         String   @db.VarChar(100)
  tanggal      DateTime @db.Date
  uraian       String   @map("uraian") @db.VarChar(500)
  kodeBukti    String?  @map("kode_bukti") @db.VarChar(50)
  debit        Float    @default(0)
  kredit       Float    @default(0)
  saldo        Float
  rekonsiliasi Boolean  @default(false) @map("rekonsiliasi")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  desa         Desa?    @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@map("buku_bank")
}

model Bansos {
  id             String   @id @default(cuid())
  desaId         BigInt?  @map("desa_id")
  nama           String   @db.VarChar(255)
  jenis          String   @db.VarChar(100) // BLT, PKH, BPNT, dll
  tahun          Int
  periode        String?  @db.VarChar(50)
  jumlahPenerima Int      @default(0) @map("jumlah_penerima")
  jumlahDana     Float    @default(0) @map("jumlah_dana")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  desa           Desa?    @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@map("bansos")
}

// ============================================================
// Saran / Aspirasi / Aduan
// ============================================================

model SaranAduan {
  id              String           @id @default(cuid())
  desaId          BigInt?          @map("desa_id")
  judul           String           @map("judul") @db.VarChar(255)
  isi             String           @map("isi") @db.Text
  kategori        String           @map("kategori") @db.VarChar(50) // SARAN, ADUAN, ASPIRASI
  status          SaranAduanStatus @default(BARU)
  namaPengirim    String?          @map("nama_pengirim") @db.VarChar(255)
  emailPengirim   String?          @map("email_pengirim") @db.VarChar(255)
  teleponPengirim String?          @map("telepon_pengirim") @db.VarChar(20)
  jawaban         String?          @map("jawaban") @db.Text
  dijawabOleh     String?          @map("dijawab_oleh") @db.VarChar(255)
  dijawabPada     DateTime?        @map("dijawab_pada") @db.Timestamp(6)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  desa            Desa?            @relation(fields: [desaId], references: [id], onUpdate: NoAction)

  @@index([desaId])
  @@index([kategori])
  @@index([status])
  @@index([createdAt])
  @@map("saran_aduan")
}

enum SaranAduanStatus {
  BARU
  DIPROSES
  SELESAI
  DITOLAK
}

// ============================================================
// Mutasi Penduduk
// ============================================================

model MutasiPenduduk {
  id              String      @id @default(cuid())
  desaId          BigInt?     @map("desa_id")
  jenisMutasi     MutasiJenis @map("jenis_mutasi")
  tanggalMutasi   DateTime    @map("tanggal_mutasi") @db.Date
  nik             String      @map("nik") @db.VarChar(16)
  namaLengkap     String      @map("nama_lengkap") @db.VarChar(255)
  jenisKelamin    String?     @map("jenis_kelamin") @db.VarChar(1)
  tanggalLahir    DateTime?   @map("tanggal_lahir") @db.Date
  // Data tambahan berdasarkan jenis mutasi
  tempatLahir     String?     @map("tempat_lahir") @db.VarChar(100)
  // Untuk Lahir
  nikAyah         String?     @map("nik_ayah") @db.VarChar(16)
  nikIbu          String?     @map("nik_ibu") @db.VarChar(16)
  // Untuk Mati
  penyebabMati    String?     @map("penyebab_mati") @db.VarChar(255)
  // Untuk Pindah Datang
  alamatAsal      String?     @map("alamat_asal") @db.VarChar(500)
  desaAsal        String?     @map("desa_asal") @db.VarChar(255)
  kecamatanAsal   String?     @map("kecamatan_asal") @db.VarChar(255)
  kabupatenAsal   String?     @map("kabupaten_asal") @db.VarChar(255)
  // Untuk Pindah Pergi
  alamatTujuan    String?     @map("alamat_tujuan") @db.VarChar(500)
  desaTujuan      String?     @map("desa_tujuan") @db.VarChar(255)
  kecamatanTujuan String?     @map("kecamatan_tujuan") @db.VarChar(255)
  kabupatenTujuan String?     @map("kabupaten_tujuan") @db.VarChar(255)
  // FK references to wilayah hierarchy (for origin)
  gubugAsalId     BigInt?     @map("gubug_asal_id")
  rwAsalId        BigInt?     @map("rw_asal_id")
  rtAsalId        BigInt?     @map("rt_asal_id")
  // FK references to wilayah hierarchy (for destination)
  gubugTujuanId   BigInt?     @map("gubug_tujuan_id")
  rwTujuanId      BigInt?     @map("rw_tujuan_id")
  rtTujuanId      BigInt?     @map("rt_tujuan_id")
  // Info tambahan
  keterangan      String?     @db.VarChar(500)
  dokumenUrl      String?     @map("dokumen_url") @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  desa        Desa?  @relation(fields: [desaId], references: [id], onUpdate: NoAction)
  // Relations for origin wilayah
  gubugAsal   Gubug? @relation("GubugAsal", fields: [gubugAsalId], references: [id], onUpdate: NoAction, map: "mutasi_gubug_asal_id_foreign")
  rwAsal      Rw?    @relation("RwAsal", fields: [rwAsalId], references: [id], onUpdate: NoAction, map: "mutasi_rw_asal_id_foreign")
  rtAsal      Rt?    @relation("RtAsal", fields: [rtAsalId], references: [id], onUpdate: NoAction, map: "mutasi_rt_asal_id_foreign")
  // Relations for destination wilayah
  gubugTujuan Gubug? @relation("GubugTujuan", fields: [gubugTujuanId], references: [id], onUpdate: NoAction, map: "mutasi_gubug_tujuan_id_foreign")
  rwTujuan    Rw?    @relation("RwTujuan", fields: [rwTujuanId], references: [id], onUpdate: NoAction, map: "mutasi_rw_tujuan_id_foreign")
  rtTujuan    Rt?    @relation("RtTujuan", fields: [rtTujuanId], references: [id], onUpdate: NoAction, map: "mutasi_rt_tujuan_id_foreign")

  @@index([desaId])
  @@index([jenisMutasi])
  @@index([tanggalMutasi])
  @@index([nik])
  @@index([gubugAsalId])
  @@index([rwAsalId])
  @@index([rtAsalId])
  @@index([gubugTujuanId])
  @@index([rwTujuanId])
  @@index([rtTujuanId])
  @@map("mutasi_penduduk")
}

enum MutasiJenis {
  LAHIR
  MATI
  PINDAH_DATANG
  PINDAH_PERGI
}

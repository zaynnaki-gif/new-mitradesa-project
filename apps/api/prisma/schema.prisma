/// News/Article category
model Kategori {
  id        BigInt   @id @default(autoincrement())
  nama      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  deskripsi String?  @db.VarChar(500)
  ikon      String?  @db.VarChar(50)
  warna     String?  @map("warna") @db.VarChar(20)
  urutan    Int      @default(0)
  isAktif   Boolean  @default(true) @map("is_aktif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  desaId    BigInt?  @map("desa_id")
  desa      Desa?    @relation(fields: [desaId], references: [id], onUpdate: NoAction, map: "kategori_desa_id_foreign")
  berita    Berita[]

  @@index([slug])
  @@index([urutan])
  @@index([desaId])
  @@map("kategori")
}

/// News/Article
model Berita {
  id          BigInt       @id @default(autoincrement())
  judul       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  excerpt     String?      @db.VarChar(500)
  konten      String       @db.Text
  gambarUrl   String?      @map("gambar_url") @db.VarChar(500)
  status      BeritaStatus @default(DRAFT)
  penulisId   BigInt?      @map("penulis_id")
  kategoriId  BigInt?      @map("kategori_id")
  publishedAt DateTime?    @map("published_at") @db.Timestamp(6)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamp(6)
  penulis     Account?     @relation("BeritaPenulis", fields: [penulisId], references: [id], onUpdate: NoAction, map: "berita_penulis_id_foreign")
  kategori    Kategori?    @relation(fields: [kategoriId], references: [id], onUpdate: NoAction, map: "berita_kategori_id_foreign")

  // SEO fields
  metaTitle     String? @map("meta_title") @db.VarChar(255)
  metaDeskripsi String? @map("meta_deskripsi") @db.VarChar(500)
  metaKeywords  String? @map("meta_keywords") @db.VarChar(255)
  ogImageUrl    String? @map("og_image_url") @db.VarChar(500)

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([kategoriId])
  @@index([penulisId])
  @@map("berita")
}

/// Static page
model Halaman {
  id          BigInt        @id @default(autoincrement())
  judul       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  konten      String        @db.Text
  excerpt     String?       @db.VarChar(500)
  gambarUrl   String?       @map("gambar_url") @db.VarChar(500)
  status      HalamanStatus @default(DRAFT)
  createdById BigInt?       @map("created_by_id")
  publishedAt DateTime?     @map("published_at") @db.Timestamp(6)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamp(6)
  createdBy   Account?      @relation("HalamanCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction, map: "halaman_created_by_id_foreign")
  desaId      BigInt?       @map("desa_id")
  desa        Desa?         @relation(fields: [desaId], references: [id], onUpdate: NoAction, map: "halaman_desa_id_foreign")

  // SEO fields
  metaTitle     String? @map("meta_title") @db.VarChar(255)
  metaDeskripsi String? @map("meta_deskripsi") @db.VarChar(500)
  metaKeywords  String? @map("meta_keywords") @db.VarChar(255)

  // Page settings
  urutan Int     @default(0)
  isMenu Boolean @default(false) @map("is_menu")

  @@index([slug])
  @@index([status])
  @@index([urutan])
  @@index([isMenu])
  @@index([desaId])
  @@map("halaman")
}

/// Media file
model Media {

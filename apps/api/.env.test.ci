# Test Environment - CI/CD
NODE_ENV=test

# Test Database - CI/CD uses Docker service
TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:5432/mitradesa_test

# Auth
JWT_SECRET=test-secret-key-must-be-at-least-64-characters-long-for-testing-purposes
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# App
API_PORT=3001

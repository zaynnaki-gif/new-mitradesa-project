# MITRADESA Production Environment Variables Template
# =============================================
# COPY THIS FILE TO: apps/api/.env.production
# AND: apps/web/.env.production
#
# DO NOT COMMIT ACTUAL VALUES - USE SECURE SECRET MANAGEMENT
# =============================================

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=production
DATABASE_ENV=production

# ===========================================
# DATABASE - PRODUCTION (REQUIRED)
# ===========================================
# PostgreSQL connection string
# Example: postgresql://user:password@host:5432/production_db
DATABASE_URL=<PRODUCTION_DATABASE_URL>

# ===========================================
# AUTHENTICATION - PRODUCTION (REQUIRED)
# ===========================================
# Generate a secure 64+ character random string
# Use: openssl rand -base64 64
JWT_SECRET=<PRODUCTION_JWT_SECRET>
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# APPLICATION
# ===========================================
API_PORT=3001
WEB_PORT=3000

# Update these with actual production domains
API_URL=<PRODUCTION_API_URL>
WEB_URL=<PRODUCTION_WEB_URL>

# ===========================================
# CORS - PRODUCTION (REQUIRED)
# ===========================================
# Only allow production frontend domain(s)
# Example: https://mitradesa.desa.id,https://www.mitradesa.desa.id
ALLOWED_ORIGINS=<PRODUCTION_ALLOWED_ORIGINS>

# ===========================================
# INSTANCE IDENTITY
# ===========================================
DESA_ID=1
DESA_KODE=<PRODUCTION_DESA_KODE>
DESA_NAMA="<PRODUCTION_DESA_NAMA>"

# ===========================================
# LOGGING - PRODUCTION
# ===========================================
LOG_LEVEL=warn

# ===========================================
# FILE STORAGE - PRODUCTION
# ===========================================
STORAGE_BACKEND=local
UPLOAD_DIR=/var/mitradesa/uploads
MAX_FILE_SIZE=10485760

# For S3 storage (optional):
# STORAGE_BACKEND=s3
# S3_BUCKET=<PRODUCTION_S3_BUCKET>
# S3_REGION=<PRODUCTION_S3_REGION>
# S3_ACCESS_KEY_ID=<PRODUCTION_S3_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<PRODUCTION_S3_SECRET>

# ===========================================
# WHATSAPP (Fonnte) - Optional
# ===========================================
# WA_API_URL=https://api.fonnte.com
# WA_API_KEY=<PRODUCTION_FONNTE_KEY>

# ===========================================
# RATE LIMITING & RELIABILITY (PRODUCTION)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MS=300000
SHUTDOWN_TIMEOUT_MS=10000

# ===========================================
# SUPABASE (if using)
# ===========================================
# SUPABASE_URL=<PRODUCTION_SUPABASE_URL>
# SUPABASE_ANON_KEY=<PRODUCTION_SUPABASE_ANON>
# SUPABASE_SERVICE_ROLE_KEY=<PRODUCTION_SUPABASE_SERVICE>

# ===========================================
# SECURITY REMARKS
# ===========================================
# 1. NEVER commit this file with actual values
# 2. Use environment-specific secrets manager
# 3. Rotate JWT_SECRET periodically
# 4. Use strong database passwords (32+ chars)
# 5. Enable SSL/TLS for all connections
# 6. Use separate database from staging/dev
# 7. Configure firewall rules appropriately

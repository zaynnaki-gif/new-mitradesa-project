# Environment
NODE_ENV=test

# ============================================================
# DATABASE - Dedicated PostgreSQL Container
# ============================================================
# Container: mitradesa-postgres-test
# Network: host mode
# Connection: 127.0.0.1:5432
# ============================================================

TEST_DATABASE_URL=postgresql://mitradesa_test:test_secure_password_2024@127.0.0.1:5432/mitradesa_test

# Auth
JWT_SECRET=test-secret-key-must-be-at-least-64-characters-long-for-testing-purposes
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# App
API_PORT=3001

# Instance Identity (test values — must match a real Desa in test DB)
DESA_ID=1
DESA_KODE=5101012001
DESA_NAMA=Desa Seruni Mumbul

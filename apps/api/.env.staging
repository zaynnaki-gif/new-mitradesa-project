# MITRADESA Staging Environment Variables
# STAGING - NOT PRODUCTION
# DO NOT USE PRODUCTION CREDENTIALS HERE

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=staging
DATABASE_ENV=staging

# ===========================================
# DATABASE - STAGING (DEDICATED)
# ===========================================
# Container: mitradesa-postgres-staging
# Network: host mode
# Connection: 127.0.0.1:5434
# ===========================================
# IMPORTANT: This MUST be different from production database
# DO NOT use production DATABASE_URL here
# ===========================================

STAGING_DATABASE_URL=postgresql://mitradesa_staging:staging_secure_password_2024@127.0.0.1:5434/mitradesa_staging

# Fallback for Prisma (it uses DATABASE_URL)
DATABASE_URL=${STAGING_DATABASE_URL}

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate a secure 64-character random string
JWT_SECRET=staging-secret-key-must-be-at-least-64-characters-long-for-security
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# APPLICATION
# ===========================================
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# FILE STORAGE - STAGING
# ===========================================
# IMPORTANT: Use separate staging storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads-staging
MAX_FILE_SIZE=10485760

# ===========================================
# WHATSAPP (Fonnte) - Optional for staging
# ===========================================
WA_API_URL=https://api.fonnte.com
WA_API_KEY=your_fonnte_api_key_here

# ===========================================
# SAFETY REMARKS
# ===========================================
# 1. This file is for STAGING environment only
# 2. Do NOT use production Supabase credentials here
# 3. Database must be separate from production
# 4. Storage must be separate from production
# 5. Run pilot seed only with NODE_ENV=staging

{
  "name": "mitradesa",
  "version": "0.1.0",
  "private": true,
  "description": "MITRADESA - Manajemen Informasi dan Administrasi Desa",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "build:api": "npm run prisma:generate -w apps/api && npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "test:e2e": "npx playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:studio": "npm run prisma:studio -w apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0"
}

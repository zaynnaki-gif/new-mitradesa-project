# ===========================================
# FILE STORAGE
# ===========================================

# Storage backend: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# S3-compatible storage (when STORAGE_BACKEND=s3)
# Supported: AWS S3, Cloudflare R2, MinIO
# S3_ENDPOINT: Leave empty for AWS S3, set for R2/MinIO
#   R2: https://xxx.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ENDPOINT=
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_URL: Custom domain for media (optional)
S3_PUBLIC_URL=
# S3_SIGNED_URL_EXPIRES: Signed URL expiry in seconds (default: 3600)
S3_SIGNED_URL_EXPIRES=3600

# ===========================================
# TEST DATABASE (REQUIRED FOR TESTS)
# ===========================================
# IMPORTANT: Tests MUST use a dedicated test database
# DO NOT use production database for tests
# Format: postgresql://username:password@host:port/database_test
TEST_DATABASE_URL=postgresql://user:password@host:5432/database_test

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

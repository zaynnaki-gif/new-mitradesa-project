# MITRADESA - Example Environment Variables
# Copy to .env and fill in actual values
# =========================================

# Database (Required)
DATABASE_URL="postgresql://postgres:password_desa_secure@localhost:5432/mitradesa_db?schema=public"

# JWT Authentication (Required)
JWT_SECRET=your-64-char-secret-key-here-please-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# App Info
APP_NAME=MITRADESA

# Instance Identity (Required - Single Tenant ADR-001)
DESA_ID=1
DESA_KODE=52.03.08.2014
DESA_NAMA="Desa Seruni Mumbul"

# Server
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# PUBLIC_WEB_URL is mandatory in production for official QR code URLs (e.g. https://serunimumbul.com)
PUBLIC_WEB_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=info

# WhatsApp (Fonnte / Notification Gateway)
WA_API_URL=https://api.fonnte.com
WA_API_KEY=your-fonnte-api-key

# File Storage
STORAGE_BACKEND=local # Options: local, s3, supabase
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloud Storage Options (S3)
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_PUBLIC_URL=https://your-s3-bucket-name.s3.amazonaws.com
S3_SIGNED_URL_EXPIRES=3600
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Cloud Storage Options (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=documents

# Rate Limiting & Reliability (Phase 1 - 4)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MS=300000
SHUTDOWN_TIMEOUT_MS=10000

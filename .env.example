# MITRADESA - Example Environment Variables
# Copy to .env and fill in actual values
# =========================================

# Database (Required)
DATABASE_URL="postgresql://postgres:password_desa_secure@localhost:5432/mitradesa_db?schema=public"

# JWT Authentication (Required)
JWT_SECRET=your-64-char-secret-key-here-please-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# App Info
APP_NAME=MITRADESA

# Instance Identity (Required - Single Tenant ADR-001)
DESA_ID=1
DESA_KODE=52.03.08.2014
DESA_NAMA="Desa Seruni Mumbul"

# Server
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=info

# WhatsApp (Fonnte / Notification Gateway)
WA_API_URL=https://api.fonnte.com
WA_API_KEY=your-fonnte-api-key

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting & Reliability (Phase 1 - 4)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MS=300000
SHUTDOWN_TIMEOUT_MS=10000
